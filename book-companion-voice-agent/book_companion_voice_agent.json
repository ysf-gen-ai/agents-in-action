      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "content": "🔊 **TEXT-TO-SPEECH**\nConverts responses to voice!\n- Uses OpenAI TTS with \"Fable\" voice\n- Takes RAG Agent text output as input\n- Returns audio binary for webhook response",
        "height": 176,
        "width": 272
      },
